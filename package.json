{
  "name": "subcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop-dist/main.js",
  "license": "AGPL-3.0-or-later",
  "author": "twoer",
  "homepage": "https://github.com/twoer/subcast",
  "repository": {
    "type": "git",
    "url": "https://github.com/twoer/subcast.git"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "node scripts/ensure-sqlite-abi.mjs node",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:llm": "vitest --run server/utils/__tests__/llmClient.test.ts server/utils/__tests__/llmServer.test.ts desktop/modelManager/__tests__/llm*.test.ts",
    "build:desktop:assets": "SUBCAST_BUILD_TARGET=desktop nuxt build",
    "build:desktop:main": "tsc -p tsconfig.desktop.json && tsc -p tsconfig.preload.json && mv -f desktop-dist/preload.js desktop-dist/preload.cjs && mv -f desktop-dist/preload.js.map desktop-dist/preload.cjs.map 2>/dev/null || true",
    "build:desktop:native": "node scripts/ensure-sqlite-abi.mjs electron",
    "build:desktop:icons": "node scripts/generate-icons.mjs",
    "build:desktop": "pnpm build:desktop:icons && pnpm build:desktop:assets && pnpm build:desktop:main && pnpm build:desktop:native && electron-builder --config electron-builder.config.cjs",
    "build:desktop:mac": "pnpm build:desktop:icons && pnpm build:desktop:assets && pnpm build:desktop:main && pnpm build:desktop:native && electron-builder --config electron-builder.config.cjs --mac",
    "build:desktop:win": "pnpm build:desktop:icons && pnpm build:desktop:assets && pnpm build:desktop:main && pnpm build:desktop:native && electron-builder --config electron-builder.config.cjs --win",
    "predev:desktop": "node scripts/ensure-sqlite-abi.mjs electron",
    "dev:desktop": "pnpm build:desktop:assets && pnpm build:desktop:main && electron .",
    "predev:desktop:hot": "node scripts/ensure-sqlite-abi.mjs electron",
    "dev:desktop:hot": "node scripts/dev-desktop-hot.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@nuxtjs/i18n": "^10.3.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.10.0",
    "bindings": "^1.5.0",
    "check-disk-space": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3",
    "h3": "1.15.11",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^1.0.0",
    "nodejs-whisper": "^0.2.9",
    "nuxt": "^4.4.0",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@vueuse/core": "^14.3.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "png2icons": "^2.0.1",
    "shadcn-nuxt": "^2.6.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.12.0"
}
